# TV Monitorinq pipeline — mühit dəyişənləri nümunəsi.
# Serverdə (Hetzner VPS) /root/tv-monitor/.env faylına real dəyərlər yazılır.
# Bu fayl yalnız sənəd üçündür — real .env HEÇ VAXT repo-ya əlavə edilmir.

# Groq Whisper API (audio -> mətn transkripsiya)
GROQ_API_KEY=
# İstəyə bağlı: klassifikasiya modeli (default openai/gpt-oss-120b, bax config.py)
# GROQ_CLASSIFY_MODEL=

# Telegram bot (healthcheck xəbərdarlıqları üçün)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# tv_monitorinq_bot webhook-unun gizli tokeni (setWebhook secret_token).
# n8n "TV Klip - Telegram Təsdiq Emalı" → "Telegram Callback" node-undakı
# onlyRunIf dəyəri ilə eyni olmalıdır (bax: README "n8n tərəfi").
TG_CALLBACK_SECRET=

# Django saytına klip ingest etmək üçün paylaşılan gizli açar
# (mediapulse.az /opt/saas_core/.env-dəki TV_CLIP_INGEST_SECRET ilə eyni olmalıdır)
DJANGO_INGEST_SECRET=
